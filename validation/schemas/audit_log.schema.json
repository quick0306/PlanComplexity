{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanComplexity audit log event",
  "type": "object",
  "required": ["event_id", "event_time", "actor", "action", "software_version", "input_hash"],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": ["analyze_plan", "export_report", "freeze_reference", "run_validation", "deploy", "rollback"]
    },
    "software_version": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "output_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "clinical_use": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
