{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expected Metrics Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "formula_version", "case_id", "domain", "mode",
    "source_checksum", "expected_metrics_checksum", "generated_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "formula_version": {"type": "string", "pattern": "\\S"},
    "case_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "source_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "expected_metrics_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
