{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clinical endpoint association record",
  "type": "object",
  "required": ["case_id"],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "metric_key": {
      "type": "string"
    },
    "metric_value": {
      "type": ["number", "string"]
    },
    "endpoint_key": {
      "type": "string"
    },
    "endpoint_value": {
      "type": ["integer", "number", "string", "boolean"]
    },
    "followup_days": {
      "type": ["integer", "number", "string", "null"]
    }
  },
  "additionalProperties": true
}
