{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation Report Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "generated_at",
    "profile_key",
    "summary",
    "results"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_key": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_metrics",
        "exact_passes",
        "exact_failures"
      ],
      "properties": {
        "total_metrics": {
          "type": "integer",
          "minimum": 0
        },
        "exact_passes": {
          "type": "integer",
          "minimum": 0
        },
        "exact_failures": {
          "type": "integer",
          "minimum": 0
        },
        "reference_exact_green": {
          "type": ["boolean", "null"]
        },
        "analysis_failures": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_failures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "domain", "analysis_status", "formula_version_status", "reference_exact_green"],
        "properties": {
          "case_id": {"type": "string"},
          "domain": {"type": "string"},
          "supported": {"type": ["boolean", "null"]},
          "expected_supported": {"type": ["boolean", "null"]},
          "analysis_status": {"type": "string", "enum": ["pass", "fail", "not-recorded"]},
          "analysis_note": {"type": "string"},
          "required_formula_version": {"type": ["string", "null"]},
          "expected_formula_version": {"type": ["string", "null"]},
          "observed_formula_version": {"type": ["string", "null"]},
          "formula_version_status": {"type": "string", "enum": ["pass", "fail", "legacy-unversioned"]},
          "formula_version_note": {"type": "string"},
          "reference_exact_green": {"type": ["boolean", "null"]}
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "metric_key",
          "comparison_class",
          "status"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "metric_key": {
            "type": "string"
          },
          "comparison_class": {
            "type": "string",
            "enum": [
              "exact-equivalent",
              "derived-equivalent",
              "association-only",
              "not-comparable"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "warning",
              "skipped"
            ]
          }
        }
      }
    }
  }
}
